{
  "name": "erp-app",
  "version": "1.0.0",
  "description": "Professional ERP/CRM System for Small Businesses",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node config/seed.js",
    "migrate": "node config/migrate.js up",
    "migrate:rollback": "node config/migrate.js down",
    "migrate:status": "node config/migrate.js status",
    "setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0"
  }
}
